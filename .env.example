# Only server-side Next.js can access this variable. Never use NEXT_PUBLIC_ for DB credentials.
# Local backend:
API_INTERNAL_URL=http://127.0.0.1:8080
# Railway after validation: http://<api-service>.railway.internal:8080

# Spring VS service must be configured with a >=32-character VS_SIGNING_SECRET.
# Local HTTP only: VS_COOKIE_SECURE=false on Spring; production: true.
# Production VS_ALLOWED_ORIGIN must match the actual browser app origin if
# the Spring API receives an Origin header directly.
